# Copy this file to `.env` and fill in actual values.

# --- LLM backend selection: "ollama" | "transformers" | "openai" ---
LLM_BACKEND=ollama

# --- Ollama settings (if LLM_BACKEND=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2:7b-instruct

# --- OpenAI-compatible settings (if LLM_BACKEND=openai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- HuggingFace (for loading models / pushing fine-tuned adapters) ---
HF_TOKEN=

# --- Embedding model ---
EMBEDDING_MODEL=keepitreal/vietnamese-sbert

# --- Cross-encoder for re-ranking ---
CROSS_ENCODER_MODEL=itdainb/PhoRanker
